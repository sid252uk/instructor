# Copy to .env.local and fill in. Never commit real keys.

# Public URL of the app, used in emails and Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project settings > API). Required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security, so keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional). Without these, card payments and subscriptions are hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=

# Email via Resend (optional). Without these, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Instructor <bookings@example.com>"

# SMS via Twilio (optional). Without these, texts are logged to the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Protects the reminder job. Vercel sends it automatically for cron jobs.
CRON_SECRET=
